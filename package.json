{
  "name": "@anoblet/copilot",
  "version": "1.0.0",
  "description": "A comprehensive GitHub Copilot enhancement framework.",
  "type": "module",
  "scripts": {
    "copilot:skills:sync": "node scripts/sync-skills.ts",
    "copilot:link:enable": "node packages/link/src/index.ts ../link.json --enable",
    "copilot:link:disable": "node packages/link/src/index.ts ../link.json --disable",
    "copilot:link:toggle": "node packages/link/src/index.ts ../link.json --toggle",
    "test": "npm run verify:safe",
    "verify:safe": "node --test --test-timeout=30000 scripts/verify-safe.test.ts"
  },
