{
  "chat.agent.maxRequests": 100000,
  "chat.agentHost.enabled": true,
  "chat.agentSkillsLocations": {
    "copilot/.github/skills": true
  },
  "chat.checkpoints.showFileChanges": true,
  "chat.experimental.useSkillAdherencePrompt": true,
  "chat.includeReferencedInstructions": true,
  "chat.promptFilesLocations": {
    "copilot/prompts": true
  },
  "chat.subagents.allowInvocationsFromSubagents": true,
  "chat.useNestedAgentsMdFiles": true,
  "chat.utilitySmallModel": "customendpoint/deepseek-v4-flash",
  "chat.viewSessions.enabled": false,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "always"
  },
  "editor.formatOnSave": true,
  "git.postCommitCommand": "sync",
  "git.repositoryScanMaxDepth": -1,
  "github.copilot.chat.agent.temperature": 0,
  "github.copilot.chat.executionSubagent.enabled": true,
  "github.copilot.chat.searchSubagent.enabled": true,
  "github.copilot.chat.skillTool.enabled": true,
  "inlineChat.defaultModel": "DeepSeek V4 Flash (customendpoint)",
  "jsts-chat-features.skills.enabled": true,
  "chat.autopilot.advanced.enabled": true,
  "chat.permissions.default": "autopilot"
}
