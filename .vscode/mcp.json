{
  "inputs": [
    {
      "type": "promptString",
      "id": "alpha_vantage_api_key",
      "description": "Alpha Vantage API Key",
      "password": true
    },
    {
      "type": "promptString",
      "id": "context7_api_key",
      "description": "Context7 API Key",
      "password": true
    },
    {
      "type": "promptString",
      "id": "tavily_api_key",
      "description": "Tavily API Key",
      "password": true
    }
  ],
  "servers": {
    "alphavantage": {
      "command": "uvx",
      "args": ["av-mcp", "${input:alpha_vantage_api_key}"]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${input:context7_api_key}"
      }
    },
    "tavily": {
      "command": "npx",
      "args": ["-y", "tavily-mcp@latest"],
      "env": {
        "TAVILY_API_KEY": "${input:tavily_api_key}"
      }
    }
  }
}
